[Unit]
Description=CryptoTrace background worker
After=network.target postgresql.service
[Service]
Type=simple
User=cryptotrace
Group=cryptotrace
WorkingDirectory=/srv/cryptotrace
EnvironmentFile=/srv/cryptotrace/.env
ExecStart=/srv/cryptotrace/.venv/bin/python worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/cryptotrace/run
UMask=0077
[Install]
WantedBy=multi-user.target
