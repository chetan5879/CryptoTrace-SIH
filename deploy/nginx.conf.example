# Replace host/certificate paths. Keep the backend bound to loopback.
limit_req_zone $binary_remote_addr zone=ct_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=ct_login:10m rate=5r/m;
server {
    listen 443 ssl;
    server_name cryptotrace.agency.example;
    ssl_certificate /etc/cryptotrace/tls/fullchain.pem;
    ssl_certificate_key /etc/cryptotrace/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    location = /auth/login {
        limit_req zone=ct_login burst=5 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        limit_req zone=ct_api burst=20 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:8000;
    }
}
